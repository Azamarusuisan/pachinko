{
  "name": "pachinko-simulation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "tools/*"],
  "scripts": {
    "setup:blender": "bash tools/setup-blender-mcp.sh",
    "generate:glb": "node tools/generate-visual-glb.mjs",
    "dev": "npm run dev -w @pachinko/simulator",
    "build": "tsc -b && npm run build -w @pachinko/simulator",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:hermes-small": "node tools/hermes-small.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "verify:structure": "node tools/verify-structure.mjs",
    "verify:phase1": "node tools/verify-phase1.mjs",
    "verify:assets": "node --import tsx tools/verify-assets.mjs",
    "verify:assets:release": "node --import tsx tools/verify-assets.mjs --release",
    "baseline:generate": "node --import tsx tools/simulation-runner/src/baseline-cli.ts",
    "baseline:check": "node --import tsx tools/simulation-runner/src/baseline-cli.ts --check",
    "corpus:plan": "node --import tsx tools/audio-corpus/src/cli.ts plan --audio 100000 --images 100 --window-ms 500",
    "corpus:images": "node --import tsx tools/audio-corpus/src/cli.ts harvest-wikimedia --target 100 --cache-dir research-data/images/wikimedia --download-dir research-data/images/wikimedia-curated --out research-data/wikimedia-images.ndjson",
    "corpus:validate": "node --import tsx tools/audio-corpus/src/cli.ts validate --manifest research-data/local-audio-sources.ndjson --manifest research-data/nojiru-audio-sources.ndjson --manifest research-data/wikimedia-images.ndjson --features research-data/local-audio-features.ndjson --features research-data/nojiru-audio-features.ndjson --target-audio 100000 --target-images 100 --require-local-media --require-local-images",
    "audio:music-report": "node --import tsx tools/audio-corpus/src/cli.ts music-report --manifest research-data/nojiru-audio-sources.ndjson --features research-data/nojiru-audio-features.ndjson --pitch research-data/nojiru-audio-pitch-report.json --out docs/music-analysis-report.json --force",
    "audio:runtime-report": "node --import tsx tools/audio-corpus/src/runtime-cue-report.ts --out research-data/runtime-cue-report.json",
    "simulate:100": "node --import tsx tools/simulation-runner/src/cli.ts --balls 100",
    "simulate:1000": "node --import tsx tools/simulation-runner/src/cli.ts --balls 1000",
    "simulate:10000": "node --import tsx tools/simulation-runner/src/cli.ts --balls 10000",
    "simulate:hz:120": "node --import tsx tools/simulation-runner/src/cli.ts --balls 1000 --physics-hz 120",
    "simulate:hz:240": "node --import tsx tools/simulation-runner/src/cli.ts --balls 1000 --physics-hz 240",
    "simulate:hz:480": "node --import tsx tools/simulation-runner/src/cli.ts --balls 1000 --physics-hz 480",
    "simulate:trace": "node --import tsx tools/simulation-runner/src/trace.ts",
    "simulate:timeouts": "node --import tsx tools/simulation-runner/src/timeout-report.ts",
    "simulate:convergence": "node --import tsx tools/simulation-runner/src/convergence-cli.ts",
    "experiment": "node --import tsx tools/simulation-runner/src/experiment-cli.ts",
    "calibration:observed": "node --import tsx tools/calibration/src/observed-cli.ts",
    "playground:windmill": "node --import tsx tools/physics-playground/src/cli.ts",
    "regression:v2-v21": "node --import tsx tools/simulation-runner/src/v21-ablation.ts",
    "golden": "node --import tsx tools/simulation-runner/src/cli.ts --balls 1000 --seed 123456 --power 0.68",
    "golden:update": "node --import tsx tools/simulation-runner/src/write-golden.ts"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.19.3",
    "pixi.js": "8.13.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "14.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
